# ============================================================================
# Cockpit IT – configuration du backend : copier ce fichier en backend/.env
# Ne JAMAIS commiter backend/.env : il contient des secrets (token Zammad, clés).
# Les valeurs contenant « votre », « exemple » ou « changez » sont considérées
# comme non renseignées.
# ============================================================================

# --- Application ---
DEBUG=false
# URL publique de l'application (liens des e-mails d'alerte)
APP_PUBLIC_URL=https://cockpit.exemple.fr
TIMEZONE=Europe/Paris

# --- Sécurité des sessions ---
# Obligatoire hors DEBUG, 32 caractères minimum. Générer avec : openssl rand -hex 32
SECRET_KEY=changez-moi-avec-openssl-rand
# Durée de session (minutes), prolongée automatiquement tant que l'utilisateur est actif
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Cookies « Secure » (HTTPS requis) : automatique, true hors DEBUG
# COOKIE_SECURE=true

# --- Base de données ---
# En production, docker-compose.prod.yml construit cette URL à partir de POSTGRES_PASSWORD.
DATABASE_URL=postgresql://cockpit:cockpit_password@postgres:5432/cockpit_db

# --- Comptes locaux ---
# true = comptes locaux autorisés ; false = SSO Microsoft uniquement (cible du CDC §4.3)
ENABLE_LOCAL_AUTH=true
# Administrateur initial : créé uniquement si aucun administrateur n'existe.
# 12 caractères minimum ; son changement est imposé à la première connexion.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Zammad (lecture seule) ---
ZAMMAD_API_URL=https://zammad.exemple.fr
# Token d'accès d'un compte agent (Profil > Token d'accès, permission ticket.agent)
ZAMMAD_API_TOKEN=votre_token_api_zammad
# URL ouverte par le bouton « Voir dans Zammad » si elle diffère de l'URL d'API
ZAMMAD_PUBLIC_URL=
# Tag identifiant les tickets « projet » affichés sur la timeline
ZAMMAD_PROJECT_TAG=#Projet
ZAMMAD_CACHE_SECONDS=300

# --- SSO Microsoft Entra ID ---
AZURE_TENANT_ID=votre_tenant_id
AZURE_CLIENT_ID=votre_client_id
AZURE_CLIENT_SECRET=votre_client_secret
# URL de redirection déclarée dans l'App Registration (plateforme « Web »)
AZURE_REDIRECT_URI=https://cockpit.exemple.fr/api/auth/callback
# false = chaque nouveau compte Microsoft attend la validation d'un administrateur
SSO_AUTO_ACTIVATE=false
# Adresses promues administrateur dès leur connexion (séparées par des virgules)
SSO_ADMIN_EMAILS=
# Rôles d'application Entra : accès autorisé (vide = pas de filtre) et administration
SSO_ALLOWED_ROLES=
SSO_ADMIN_ROLES=Cockpit.Admin

# --- Alertes e-mail sur les échéances de contrats ---
ALERTS_ENABLED=false
ALERT_RECIPIENTS=informatique@exemple.fr
# Rappels avant la date limite de résiliation (jours) et avant la fin d'un contrat
ALERT_DAYS_BEFORE_DEADLINE=60,30,7
ALERT_END_DAYS=30
# Heure (locale) à partir de laquelle le récapitulatif quotidien est envoyé
ALERT_HOUR=7
# none | graph (Microsoft 365, permission d'application Mail.Send) | smtp
MAIL_BACKEND=none
MAIL_FROM=cockpit@exemple.fr
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# --- CORS (inutile quand l'application est servie par Nginx ou Vite : même origine) ---
CORS_ORIGINS=http://localhost:5173
