# Aucun secret ici : toute variable VITE_* est intégrée au code envoyé aux navigateurs.

# Backend vers lequel Vite relaie /api en développement (npm run dev hors Docker)
VITE_PROXY_TARGET=http://localhost:8001

# Base de l'API vue par le navigateur (laisser /api, relayé par Vite ou Nginx)
# VITE_API_BASE_URL=/api
