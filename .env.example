# Variables lues par docker compose (fichier .env à la racine, jamais commité).
# Copier ce fichier en .env puis renseigner les valeurs.

# Mot de passe PostgreSQL (production). Générer avec : openssl rand -hex 24
# Hexadécimal conseillé : il est repris tel quel dans l'URL de connexion du backend.
POSTGRES_PASSWORD=

# Adresse et port d'écoute de l'application (production).
# 127.0.0.1 = accessible uniquement via le reverse proxy HTTPS du serveur.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
